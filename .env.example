# Browser-safe Supabase project values only. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only NVIDIA NIM API key for the chat bot. Never use a VITE_ prefix.
# Model: nvidia/nemotron-3.5-lightning-30b-a3b
# Get one from: https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
