# Browser-safe Supabase project values only. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only OpenCode Zen API key for the chat bot. Never use a VITE_ prefix.
# Model: deepseek-v4.1-flash
# Get one from: https://opencode.ai/auth
OPENCODE_API_KEY=your-opencode-zen-api-key-here
