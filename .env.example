# Browser-safe Supabase project values only. Never add a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# NVIDIA NIM API Key — ONLY chat bot provider (streaming + reasoning/thinking)
# Model: nvidia/nemotron-3.5-lightning-30b-a3b
# Get one from: https://build.nvidia.com/nvidia/nemotron-3.5-lightning
VITE_NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here

